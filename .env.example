# Переменные для запуска на сервере (файл .env рядом с docker-compose). В git не коммитить.
# Адрес сайта: по нему бот даёт ссылку и регистрирует webhook.
PUBLIC_URL=https://akcham.confhub.kg
# Токен Telegram-бота от @BotFather.
TELEGRAM_BOT_TOKEN=
# Ключ Gemini (aistudio.google.com) для «Объяснить проще» и письма; пусто — шаблоны.
GEMINI_API_KEY=
